{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zickonezero-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // worker-mailer needs the Node compat layer for its SMTP client.
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "0c4a1637a60ec527675c7e248b73e39d",
  // The zickonezero.com zone is not in the ZICKONEZERO Cloudflare account, so the
  // Worker is served from its workers.dev hostname and the site calls it
  // cross-origin (CORS is handled in src/index.ts). If the zone is ever moved
  // into this account, add zone routes for www.zickonezero.com/api/contact and
  // drop NEXT_PUBLIC_CONTACT_ENDPOINT so the form goes same-origin.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://www.zickonezero.com,https://zickonezero.com"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   BREVO_USER, BREVO_SMTP_PASSWORD, BREVO_FROM, BREVO_TO
}
